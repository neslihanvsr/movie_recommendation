{
  "drag_and_drop_steps": [
    {
      "type": "scroll",
      "name": "Scroll to Quiz Questions (Skip Video)",
      "params": {
        "element": {
          "multiLocator": {
            "ab": "quiz-questions",
            "at": "//*[contains(@class, \"quiz-questions\") or contains(@class, \"question-container\")]",
            "cl": "//*[@id=\"questions-section\"]",
            "co": "[data-testid=\"quiz-questions\"]"
          }
        }
      },
      "timeout": 30
    },
    {
      "type": "waitForElement",
      "name": "Wait for Drag and Drop Question",
      "params": {
        "element": {
          "multiLocator": {
            "ab": "drag-drop-question",
            "at": "//*[contains(@class, \"drag-drop\") or contains(@class, \"draggable\")]",
            "cl": "//*[@data-question-type=\"drag-drop\"]",
            "co": "[data-testid=\"drag-drop-question\"]"
          }
        }
      },
      "timeout": 30
    },
    {
      "type": "dragAndDrop",
      "name": "Drag First Answer to Drop Zone",
      "params": {
        "source": {
          "multiLocator": {
            "ab": "draggable-item-1",
            "at": "//*[contains(@class, \"draggable-item\")][1]",
            "cl": "//*[@data-draggable=\"item-1\"]",
            "co": ".draggable-item:first-child"
          }
        },
        "target": {
          "multiLocator": {
            "ab": "drop-zone-1",
            "at": "//*[contains(@class, \"drop-zone\")][1]",
            "cl": "//*[@data-drop-zone=\"zone-1\"]",
            "co": ".drop-zone:first-child"
          }
        }
      },
      "timeout": 30
    },
    {
      "type": "dragAndDrop",
      "name": "Drag Second Answer to Drop Zone",
      "params": {
        "source": {
          "multiLocator": {
            "ab": "draggable-item-2",
            "at": "//*[contains(@class, \"draggable-item\")][2]",
            "cl": "//*[@data-draggable=\"item-2\"]",
            "co": ".draggable-item:nth-child(2)"
          }
        },
        "target": {
          "multiLocator": {
            "ab": "drop-zone-2",
            "at": "//*[contains(@class, \"drop-zone\")][2]",
            "cl": "//*[@data-drop-zone=\"zone-2\"]",
            "co": ".drop-zone:nth-child(2)"
          }
        }
      },
      "timeout": 30
    },
    {
      "type": "dragAndDrop",
      "name": "Drag Third Answer to Drop Zone",
      "params": {
        "source": {
          "multiLocator": {
            "ab": "draggable-item-3",
            "at": "//*[contains(@class, \"draggable-item\")][3]",
            "cl": "//*[@data-draggable=\"item-3\"]",
            "co": ".draggable-item:nth-child(3)"
          }
        },
        "target": {
          "multiLocator": {
            "ab": "drop-zone-3",
            "at": "//*[contains(@class, \"drop-zone\")][3]",
            "cl": "//*[@data-drop-zone=\"zone-3\"]",
            "co": ".drop-zone:nth-child(3)"
          }
        }
      },
      "timeout": 30
    }
  ]
}